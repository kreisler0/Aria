<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AriaWindows.Controls.ItemRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AriaWindows.Controls"
    xmlns:helpers="using:AriaWindows.Helpers">
    <Grid Padding="2,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:CompletionCheck
            VerticalAlignment="Center"
            IsChecked="{x:Bind Row.IsCompleted, Mode=TwoWay}"
            Visibility="{x:Bind helpers:Ui.Visible(Row.IsTask), Mode=OneWay}" />
        <Rectangle
            Width="4"
            Height="34"
            Margin="13,0"
            VerticalAlignment="Center"
            Fill="{ThemeResource AccentFillColorDefaultBrush}"
            RadiusX="2"
            RadiusY="2"
            Visibility="{x:Bind helpers:Ui.Visible(Row.IsEvent), Mode=OneWay}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock
                Opacity="{x:Bind helpers:Ui.DoneOpacity(Row.IsCompleted), Mode=OneWay}"
                Text="{x:Bind Row.Title, Mode=OneWay}"
                TextDecorations="{x:Bind helpers:Ui.Strike(Row.IsCompleted), Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{x:Bind helpers:Ui.DetailBrush(Row.IsOverdue), Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Row.Detail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind helpers:Ui.Visible(Row.HasDetail), Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
            <Border
                Padding="8,2"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="10"
                Visibility="{x:Bind helpers:Ui.Visible(Row.HasPriority), Mode=OneWay}">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Row.PriorityText, Mode=OneWay}" />
            </Border>
            <PathIcon
                Width="12"
                Height="12"
                Data="M8,0 L9.6,6.4 L16,8 L9.6,9.6 L8,16 L6.4,9.6 L0,8 L6.4,6.4 Z"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                ToolTipService.ToolTip="Added by Aria"
                Visibility="{x:Bind helpers:Ui.Visible(Row.IsFromAi), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
