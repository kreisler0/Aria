<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AriaWindows.Controls.CompletionCheck"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button
        x:Name="ToggleButton"
        Width="30"
        Height="30"
        Padding="0"
        AutomationProperties.Name="Not completed"
        Background="Transparent"
        BorderThickness="0"
        Click="ToggleButton_Click"
        CornerRadius="15">
        <Grid Width="24" Height="24">
            <Ellipse x:Name="Ring" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="2" />
            <Ellipse x:Name="FillCircle" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Path
                x:Name="CheckPath"
                Data="M6.5,12.5 L10.5,16.5 L17.5,8.5"
                Stroke="White"
                StrokeDashArray="10 10"
                StrokeDashOffset="10"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="2.4" />
        </Grid>
    </Button>
</UserControl>
