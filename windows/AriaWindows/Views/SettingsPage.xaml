<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AriaWindows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AriaWindows.Helpers"
    xmlns:services="using:Aria.Core.Services"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="40,28,40,40" HorizontalAlignment="Stretch" Spacing="16">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />

            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Account" />
                    <TextBlock Text="{x:Bind ViewModel.AccountName, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.AccountEmail, Mode=OneWay}" />
                    <Button Margin="0,8,0,0" Command="{x:Bind ViewModel.SignOutCommand}" Content="Sign out" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Assistant" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.HasApiKey), Mode=OneWay}">
                        <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE72E;" />
                        <TextBlock VerticalAlignment="Center" Text="OpenRouter key saved in the Windows Credential Locker" />
                        <Button Command="{x:Bind ViewModel.RemoveApiKeyCommand}" Content="Remove" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.NeedsApiKey), Mode=OneWay}">
                        <PasswordBox Width="320" Header="OpenRouter API key" Password="{x:Bind ViewModel.ApiKeyInput, Mode=TwoWay}" PlaceholderText="sk-or-…" />
                        <Button VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SaveApiKeyCommand}" Content="Save" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <ComboBox
                        MinWidth="320"
                        Header="Model"
                        ItemsSource="{x:Bind ViewModel.Models}"
                        SelectedItem="{x:Bind ViewModel.SelectedModelOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:OpenRouterModel">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Id}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            Width="320"
                            Header="Any other OpenRouter model id"
                            PlaceholderText="e.g. mistralai/mistral-large"
                            Text="{x:Bind ViewModel.CustomModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button VerticalAlignment="Bottom" Command="{x:Bind ViewModel.UseCustomModelCommand}" Content="Use" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="The key never leaves this PC except to call OpenRouter. The model choice syncs to your other devices."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Appearance" />
                    <RadioButtons x:Name="ThemePicker" Header="Theme" MaxColumns="3" SelectionChanged="ThemePicker_SelectionChanged">
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </RadioButtons>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Aria follows your Windows accent colour (Settings ▸ Personalization ▸ Colors)."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Backend" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.BackendUrl, Mode=OneWay}" />
                    <Button Command="{x:Bind ViewModel.DisconnectBackendCommand}" Content="Use a different Supabase project" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.CanChangeBackend), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
