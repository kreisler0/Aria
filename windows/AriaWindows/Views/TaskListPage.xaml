<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AriaWindows.Views.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AriaWindows.Controls"
    xmlns:helpers="using:AriaWindows.Helpers"
    xmlns:vm="using:Aria.Core.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedTasks" IsSourceGrouped="True" ItemsPath="Items" />
    </Page.Resources>

    <Grid Padding="40,28,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid MaxWidth="820">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Tasks" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="CompletedToggle" Click="CompletedToggle_Click" Content="Show completed" />
                <Button Click="NewTask_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="New task" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" MaxWidth="820" Margin="0,20,0,0" Style="{StaticResource GlassCardStyle}">
            <Grid>
                <ListView
                    IsItemClickEnabled="True"
                    ItemClick="Item_Click"
                    ItemsSource="{x:Bind GroupedTasks.View, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:TaskGroupViewModel">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ContentThemeTransition />
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemRowViewModel">
                            <Grid Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="Edit_Click" Tag="{x:Bind}" Text="Edit">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="Delete_Click" Tag="{x:Bind}" Text="Delete">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <controls:ItemRow Row="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6"
                    Visibility="{x:Bind helpers:Ui.Visible(ViewModel.HasNoTasks), Mode=OneWay}">
                    <FontIcon HorizontalAlignment="Center" FontSize="32" Glyph="&#xE9D5;" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="No tasks" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Add one, or ask Aria." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
