<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AriaWindows.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AriaWindows.Helpers">

    <ScrollViewer>
        <StackPanel MaxWidth="440" Padding="24,48" HorizontalAlignment="Center" Spacing="20">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <Image Width="72" Height="72" Source="ms-appx:///Assets/AriaIcon.png" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource TitleLargeTextBlockStyle}" Text="Aria" />
                <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Your planner, run by an assistant." />
            </StackPanel>

            <!-- First run without a bundled backend: connect a Supabase project. -->
            <Border Style="{StaticResource GlassCardStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.NeedsBackend), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Connect your backend" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Aria keeps your planner in your own Supabase project (Project Settings ▸ API)." TextWrapping="Wrap" />
                    <TextBox Header="Project URL" PlaceholderText="https://your-project.supabase.co" Text="{x:Bind ViewModel.BackendUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Anon / publishable key" Text="{x:Bind ViewModel.AnonKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ConnectBackendCommand}" Content="Connect" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCardStyle}" Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.NeedsBackend), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="Create a new account" IsOn="{x:Bind ViewModel.IsSignUp, Mode=TwoWay}" />
                    <TextBox Header="Name" Text="{x:Bind ViewModel.NameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsSignUp), Mode=OneWay}" />
                    <TextBox Header="Email" InputScope="EmailSmtpAddress" Text="{x:Bind ViewModel.EmailInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox Header="Password" KeyDown="Password_KeyDown" Password="{x:Bind ViewModel.PasswordInput, Mode=TwoWay}" />
                    <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SubmitAuthCommand}" Style="{StaticResource AccentButtonStyle}">
                        <Grid>
                            <TextBlock Text="Continue" Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.IsBusy), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        </Grid>
                    </Button>
                    <HyperlinkButton
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.DisconnectBackendCommand}"
                        Content="Use a different Supabase project"
                        Visibility="{x:Bind helpers:Ui.Visible(ViewModel.CanChangeBackend), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.AuthMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind helpers:Ui.VisibleIfText(ViewModel.AuthMessage), Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
