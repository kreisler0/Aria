<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AriaWindows.Views.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AriaWindows.Controls"
    xmlns:helpers="using:AriaWindows.Helpers"
    xmlns:vm="using:Aria.Core.ViewModels"
    Background="Transparent">

    <!-- Minimal by design (spec §6): greeting, the next 3–5 items, and the AI bar. -->
    <Grid Padding="40,28,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.TodayText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,16" VerticalScrollBarVisibility="Auto">
            <Border MaxWidth="760" VerticalAlignment="Top" Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Up next" />
                        <ProgressRing
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Right"
                            IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                    </Grid>
                    <ListView
                        IsItemClickEnabled="True"
                        ItemClick="Item_Click"
                        ItemsSource="{x:Bind ViewModel.Upcoming}"
                        SelectionMode="None">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <ContentThemeTransition />
                                <ReorderThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ItemRowViewModel">
                                <controls:ItemRow Row="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel
                        Padding="0,24"
                        HorizontalAlignment="Center"
                        Spacing="6"
                        Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.HasUpcoming), Mode=OneWay}">
                        <FontIcon HorizontalAlignment="Center" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE73E;" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Nothing else today" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Ask Aria to plan something, or enjoy the free time." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- The floating glass AI bar: type here, press Enter, and the assistant takes over. -->
        <Border Grid.Row="2" MaxWidth="760" Style="{StaticResource AiBarStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PathIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Data="M8,0 L9.6,6.4 L16,8 L9.6,9.6 L8,16 L6.4,9.6 L0,8 L6.4,6.4 Z"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBox
                    x:Name="PromptBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    KeyDown="PromptBox_KeyDown"
                    PlaceholderText="Ask Aria to plan something…"
                    Text="{x:Bind ViewModel.QuickPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    Padding="0"
                    AutomationProperties.Name="Ask Aria"
                    Command="{x:Bind ViewModel.AskFromTodayCommand}"
                    CornerRadius="20"
                    Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE724;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
