// Copy to Secrets.xcconfig (git-ignored) and fill in your Supabase project's API
// settings (Project Settings ▸ API). The anon/publishable key is safe to ship: Row-Level
// Security protects the data. Never put the service_role key here.
//
// xcconfig treats "//" as a comment, so write the URL with "$()" between the slashes:

ARIA_SUPABASE_URL = https:/$()/your-project-ref.supabase.co
ARIA_SUPABASE_ANON_KEY = your-anon-or-publishable-key
